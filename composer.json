{
	"name": "pronamic/pronamic-pay-with-rabo-smart-pay-for-woocommerce",
	"description": "Pronamic Pay plugin with Rabo Smart Pay for WooCommerce integration.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"automattic/jetpack-autoloader": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"platform-check": false,
		"sort-packages": true,
		"wp-slug": "pronamic-pay-with-rabo-smart-pay-for-woocommerce"
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"vendor:pronamic",
				"vendor:wp-pay",
				"vendor:wp-pay-extensions",
				"vendor:wp-pay-gateways",
				"woocommerce/action-scheduler"
			]
		}
	},
	"require": {
		"php": ">=8.3",
		"automattic/jetpack-autoloader": "^5.0",
		"composer/installers": "^2.3",
		"pronamic/pronamic-pay-default-payment-methods": "^1.1",
		"woocommerce/action-scheduler": "^4.2",
		"wp-pay-extensions/woocommerce": "^4.15",
		"wp-pay-gateways/omnikassa-2": "^4.10",
		"wp-pay/core": "^4.35"
	},
	"require-dev": {
		"pronamic/changelog-md-to-wordpress-plugin-readme-txt": "dev-main",
		"pronamic/pronamic-cli": "^1.1",
		"pronamic/wp-coding-standards": "^2.5",
		"roots/wordpress-no-content": "^7.1",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli-bundle": "*"
	},
	"scripts": {
		"phpcs": "vendor/bin/phpcs -s -v --ignore=packages,build",
		"build": [
			"Pronamic\\ChangelogMdToWordPressPluginReadmeTxt\\Synchronizer::run",
			"rm -rf ./build/stage-1",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ --exclude=/packages/ --exclude=/node_modules/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --delete --delete-excluded --verbose --exclude-from=.distignore ./build/stage-1/ ./build/pronamic-pay-with-rabo-smart-pay-for-woocommerce/",
			"vendor/bin/phpcbf -s -v --standard=phpcs-text-domain-fixer.xml ./build/pronamic-pay-with-rabo-smart-pay-for-woocommerce/ || [ $? -eq 1 ]",
			"vendor/bin/wp i18n make-pot ./build/pronamic-pay-with-rabo-smart-pay-for-woocommerce/ --slug=pronamic-pay-with-rabo-smart-pay-for-woocommerce",
			"vendor/bin/wp i18n make-mo ./build/pronamic-pay-with-rabo-smart-pay-for-woocommerce/languages/",
			"vendor/bin/wp dist-archive ./build/pronamic-pay-with-rabo-smart-pay-for-woocommerce/ --plugin-dirname=pronamic-pay-with-rabo-smart-pay-for-woocommerce --force"
		],
		"translate": [
			"@build",
			"rsync --recursive --delete --verbose ./build/pronamic-pay-with-rabo-smart-pay-for-woocommerce/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/pronamic-pay-with-rabo-smart-pay-for-woocommerce.pot"
		],
		"version": "@build"
	}
}
